{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pz-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]

},

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<YOUR_HYPERDRIVE_CONFIG_ID>",
      "localConnectionString": "mysql://pz_user:pz_pass@127.0.0.1:3306/pz_db"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "pz-item-photos"
    }
  ],

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "vars": {
    "DEV_BYPASS_AUTH": "false",
    "GOOGLE_CLIENT_ID": "",
    "INITIAL_ADMIN_EMAIL": "admin@agh.edu.pl"
  },

  "env": {
    "production": {
      "vars": {
        "DEV_BYPASS_AUTH": "false",
        "GOOGLE_CLIENT_ID": "<YOUR_GOOGLE_CLIENT_ID>",
        "INITIAL_ADMIN_EMAIL": "<YOUR_INITIAL_ADMIN_EMAIL>"
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "<YOUR_HYPERDRIVE_CONFIG_ID>"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS_BUCKET",
          "bucket_name": "pz-item-photos"
        }
      ],
      "routes": [
        {
          "pattern": "<YOUR_DOMAIN>",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.1
        }
      },
      "triggers": {
        "crons": ["0 * * * *"]
      }
    }
  }
}
