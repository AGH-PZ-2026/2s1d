{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pz-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<YOUR_HYPERDRIVE_CONFIG_ID>",
      "localConnectionString": "mysql://pz_user:pz_pass@127.0.0.1:3306/pz_db"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "pz-item-photos"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "pz-notifications"
      }
    ]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },

  "vars": {
    "JWT_SECRET": "",
    "DEV_BYPASS_AUTH": "true",
    "GOOGLE_CLIENT_ID": ""
  },

  "env": {
    "production": {
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "<YOUR_HYPERDRIVE_CONFIG_ID>"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS_BUCKET",
          "bucket_name": "pz-item-photos"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_QUEUE",
            "queue": "pz-notifications"
          }
        ]
      },
      "routes": [
        {
          "pattern": "<YOUR_DOMAIN>",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.1
        }
      }
    }
  }
}
